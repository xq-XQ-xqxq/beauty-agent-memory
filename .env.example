# OpenAI-compatible LLM endpoint. This can point to an Alibaba/Qwen-compatible service.
# 优先读取系统环境变量DASHSCOPE_API_KEY，无需把密钥写入本文件。
MEM0_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MEM0_LLM_MODEL=qwen-plus

# Embedding endpoint. It may share the same endpoint/key or use a separate service.
MEM0_EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MEM0_EMBED_MODEL=text-embedding-v4

# Local vector database files.
MEM0_DATA_DIR=./data
MEM0_DIR=./data/mem0_home
MEM0_TELEMETRY=False
